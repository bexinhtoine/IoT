# Smart Logistics Sorter — sdkconfig.defaults (ESP-IDF v5.2 / v5.3, target esp32)
# Các giá trị này chỉ là mặc định ban đầu; idf.py menuconfig ghi đè vào sdkconfig (không commit).

# ---- Flash & phân vùng (P2 yêu cầu 10) ----
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- OTA rollback (O-13): ảnh mới khởi động ở trạng thái PENDING_VERIFY ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Không bật CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK (cần eFuse secure version) — chống rollback làm ở tầng ứng dụng (O-11).

# ---- Task Watchdog (E-09) ----
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# ---- Log ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ---- TLS / HTTP: KHÔNG BAO GIỜ bỏ xác minh chứng chỉ (O-09) ----
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set
# CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP is not set
CONFIG_ESP_TLS_USING_MBEDTLS=y
# mbedTLS giữ mặc định (ECDSA P-256 + SHA-256 + base64 đã có sẵn)
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_SHA256_C=y

# ---- Wi-Fi chỉ dùng khi OTA; giảm RAM tĩnh ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Không lưu cấu hình Wi-Fi vào NVS của driver (code tự gọi esp_wifi_set_storage(WIFI_STORAGE_RAM))

# ---- Compiler ----
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
