# Sao chép thành .env (không commit .env). Các giá trị dưới là mặc định của docker-compose.yml.
# Tag image — đối chiếu https://hub.docker.com/r/thingsboard/tb-postgres/tags
TB_IMAGE_TAG=3.7.0
# Cổng web UI/REST trên máy chủ (map vào 9090 của container)
TB_HTTP_PORT=8080
# Cổng MQTT TLS trên máy chủ
TB_MQTTS_PORT=8883

# Dùng bởi tools/rpc_cli.py và tools/tb_provision.py (mật khẩu KHÔNG ghi vào file; tool hỏi bằng getpass)
TB_URL=http://localhost:8080
TB_USER=tenant@thingsboard.org
TB_DEVICE=sorter-pi-01
# Nếu bật HTTPS cho web UI bằng cert CA nội bộ:
# TB_CA_CERT=pki/out/ca.pem
